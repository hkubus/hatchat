# ---- server ---------------------------------------------------------------
HAT_PORT=8787
HAT_HOST=127.0.0.1
# Bearer token required on /api when set. REQUIRED before exposing the server.
HAT_AUTH_TOKEN=
HAT_ENROLL_TOKEN=dev-enroll-token
HAT_MAX_TOOL_ITERATIONS=5
# SSE keepalive comment interval in ms; 0 disables. Keeps idle turn streams
# alive through proxies and works around WebKit withholding streamed bodies.
HAT_SSE_KEEPALIVE_MS=1000
# Origins allowed to call /api cross-origin (native shells). Defaults to the
# Tauri desktop origins plus the vite dev server.
HAT_CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:5173,http://127.0.0.1:5173

# Persistence + secret encryption
HAT_DB_PATH=./.hat/hat.db
# 64-char hex (or base64) key. If unset, a key file is generated at this path.
HAT_MASTER_KEY=
HAT_MASTER_KEY_FILE=./.hat/master.key
# Where uploaded attachments are stored (keyed by content hash)
HAT_UPLOAD_DIR=./.hat/uploads

# Optional S3-compatible object storage for attachments/artifacts.
# When set, blobs go to the bucket and browsers get presigned GET URLs.
HAT_S3_BUCKET=
HAT_S3_REGION=us-east-1
HAT_S3_ENDPOINT=
HAT_S3_PREFIX=
HAT_S3_PATH_STYLE=true
HAT_S3_ACCESS_KEY_ID=
HAT_S3_SECRET_ACCESS_KEY=
HAT_S3_SESSION_TOKEN=
HAT_S3_URL_EXPIRES=3600

# Plugin + app metadata
HAT_APP_TITLE=hat
HAT_APP_URL=
HAT_PLUGINS_DIR=./plugins

# ---- auth ----------------------------------------------------------------
# Set a password to require login (single-user). Empty = auth disabled.
HAT_AUTH_PASSWORD=
# Or a precomputed hash: scrypt$<saltHex>$<hashHex>
HAT_AUTH_PASSWORD_HASH=
# Set true when serving over HTTPS so cookies are marked Secure.
HAT_COOKIE_SECURE=false
HAT_SESSION_TTL_HOURS=168

# ---- provider keys (optional; or POST /api/secrets) -----------------------
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# ---- runner ---------------------------------------------------------------
HAT_SERVER_URL=ws://127.0.0.1:8787/link
HAT_RUNNER_ID=
HAT_RUNNER_TAGS=local
HAT_WORKSPACE_ROOT=./.hat/workspaces
HAT_EXEC_TIMEOUT_MS=120000
HAT_EXEC_MAX_TIMEOUT_MS=600000
HAT_EXEC_MAX_OUTPUT_BYTES=1000000

# Sandbox tier for shell commands: host (default) or container.
HAT_EXEC_SANDBOX=host
HAT_SANDBOX_RUNTIME=docker
HAT_SANDBOX_IMAGE=node:22-slim
HAT_SANDBOX_NETWORK=none
HAT_SANDBOX_MEMORY=512m
HAT_SANDBOX_CPUS=1
