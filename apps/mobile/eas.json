{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "install": {
      "exclude": "../../node_modules"
    }
  },
  "build": {
    "base": {
      "node": "22.20.0",
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      }
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "channel": "development",
      "developmentClient": true,
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      }
    },
    "device": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
